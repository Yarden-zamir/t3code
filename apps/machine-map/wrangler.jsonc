{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t3-machine-map",
  // The deploy uses this account. `node scripts/setup.ts` writes it and ACCOUNT_ID below.
  "account_id": "2b654a284959a6a3b93fe33940d70db0",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "t3.yarden-zamir.com", "custom_domain": true }],
  // The page bundle from `vp build`. The Worker runs first only for its own paths.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/connect", "/enroll", "/enroll/*", "/client/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "MAP", "class_name": "MachineMapObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MachineMapObject"] }],
  // `node scripts/setup.ts` writes these values (README, "First-time setup"). The Access app ids
  // and audiences are not here: the portal finds them and stores them (MM-1216).
  "vars": {
    // The JWT issuer. Every Access check fails while it starts with REPLACE_.
    "TEAM_DOMAIN": "super-bird-2876.cloudflareaccess.com",
    "OWNER_EMAILS": "dev@yarden-zamir.com",
    "ACCOUNT_ID": "2b654a284959a6a3b93fe33940d70db0",
    // MM-213: the tunnel of a new machine is `t3-<slug>.<MACHINE_DOMAIN>` in this zone.
    "MACHINE_DOMAIN": "yarden-zamir.com",
    "MACHINE_ZONE_ID": "29b67e3ab7b83f4fc3728c67d3082a83",
  },
  // Secrets (`wrangler secret put`): SECRET_KEY (required for joins), CF_API_TOKEN (required at
  // the first start, MM-1216), VAPID_JWK (push), MACHINE_ACCESS_SUBJECTS (optional, MM-213).
}
