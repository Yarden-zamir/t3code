{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        // The setup script is a plain Node script, like the Worker that it shares code with.
        "diagnosticSeverity": {
          "globalDate": "off",
          "globalConsole": "off",
          "globalFetch": "off",
          "nodeBuiltinImport": "off",
          "preferSchemaOverJson": "off"
        }
      }
    ]
  },
  "include": ["scripts/**/*.ts"]
}
